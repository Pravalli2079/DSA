// Approach: Copy each element to its rotated position.
//leetcode:https://leetcode.com/problems/rotate-array/submissions/2184766837/
// Time Complexity: O(n)
// Space Complexity: O(n)

class Solution {
    public void rotate(int[] nums, int k) {

        int n = nums.length;
        k = k % n;

        int[] temp = new int[n];

        for (int i = 0; i < n; i++) {
            temp[(i + k) % n] = nums[i];
        }

        for (int i = 0; i < n; i++) {
            nums[i] = temp[i];
        }
    }
}